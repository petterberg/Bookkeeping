# ─── Supabase ───────────────────────────────────────────────────
# Från Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Service role-nyckeln bypassar RLS — får ALDRIG in i klienten
SUPABASE_SERVICE_ROLE_KEY=

# ─── Fortnox OAuth 2.0 ──────────────────────────────────────────
# Skapa en integration på https://developer.fortnox.se/ och fyll i:
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
# Måste matcha exakt det som registrerats i Fortnox developer portal
FORTNOX_REDIRECT_URI=http://localhost:3000/api/fortnox/callback

# Valfritt: överstyr var Fortnox-tokenfilen sparas
# FORTNOX_TOKEN_PATH=/var/data

# ─── Session ────────────────────────────────────────────────────
NEXTAUTH_SECRET=
